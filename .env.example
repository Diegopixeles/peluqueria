# ──────────────────────────────────────────────────────────
# Variables de entorno para docker-compose
# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas ".env" a Git (está en .gitignore).
# ──────────────────────────────────────────────────────────

# Puerto local donde se sirve la web (http://localhost:8080)
WEB_PORT=8080

# Puerto local de phpMyAdmin (http://localhost:8081)
PMA_PORT=8081

# Puerto local de MySQL (para conectarte con HeidiSQL, DBeaver, etc.)
DB_PORT=3306

# Base de datos
DB_NAME=peluqueria

# Contraseña de root de MySQL (cámbiala si quieres)
DB_ROOT_PASS=rootpassword

# Usuario y contraseña que usará la app PHP
DB_USER=root
DB_PASS=rootpassword
